# ───────────────────────────────────────────────────────────────────────────
# GetCited — copy this to `.env` (local) or add each as a GitHub Actions secret.
# You can launch with as few as ONE provider key set. Missing providers are
# skipped gracefully (the report just notes "not checked").
# ───────────────────────────────────────────────────────────────────────────

# --- AI providers (at least one required) ---
# OpenAI (ChatGPT)        https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini           https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Perplexity              https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# --- Email delivery (optional; reports are also written to ./out as HTML) ---
# Resend                  https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address must be on a domain you verified in Resend.
REPORT_FROM="GetCited <reports@yourdomain.com>"

# --- Optional model overrides (sensible defaults if blank) ---
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.0-flash
PERPLEXITY_MODEL=sonar
