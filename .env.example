# Copy to .env and fill in. Never commit the real .env.

# --- Anthropic (AI content generation) ---
ANTHROPIC_API_KEY=sk-ant-...
# Defaults to the most capable model. Override only if you have a reason.
ANTHROPIC_MODEL=claude-opus-4-7
# Thinking depth / token spend for generation: low | medium | high | max
CONTENT_EFFORT=medium
# Adaptive thinking: on | off  (off is faster/cheaper for simple captions)
CONTENT_THINKING=on

# --- Instagram Graph API (official, ToS-compliant) ---
# A long-lived access token for an Instagram Business/Creator account linked
# to a Facebook Page, with a Meta app that has instagram_content_publish +
# instagram_manage_insights. See README for the setup walkthrough.
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_GRAPH_VERSION=v21.0

# --- Local storage ---
IGKIT_DB=data/igkit.db
